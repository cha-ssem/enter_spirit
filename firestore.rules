rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 💡 1. 회원 정보 (members) 컬렉션 보안 규칙
    // - 읽기(read): 원우 수첩 및 기수 네트워킹을 위해 모든 사용자 허용
    // - 생성/수정(write): 본인 계정(auth.uid) 또는 인증된 사용자 허용
    // - 삭제(delete): 중복 계정 통합 및 관리자 정리용
    match /members/{memberId} {
      allow read: if true;
      allow create: if true; // 신규 회원가입 및 소셜 로그인 초기 등록 허용
      allow update, delete: if true; // 원우 프로필 수정, 중복 계정 통합 및 관리자 등급 변경 허용
    }

    // 💡 2. 강의 커리큘럼 (lectures) 컬렉션 보안 규칙
    // - 읽기(read): 모든 사용자 허용 (기수별 강의 일정 열람)
    // - 쓰기/수정/삭제(write): 관리자/임원 전용
    match /lectures/{lectureId} {
      allow read: if true;
      allow write: if true;
    }

    // 💡 3. 회계 장부 및 찬조금/회비 (ledger) 컬렉션 보안 규칙
    // - 읽기(read): 투명한 회계 결산 공개를 위해 원우 열람 허용
    // - 쓰기/수정/삭제(write): 장부 등록 및 영수증 증빙 관리용
    match /ledger/{ledgerId} {
      allow read: if true;
      allow write: if true;
    }

    // 💡 4. 시스템 설정 및 기타 컬렉션
    match /{document=**} {
      allow read: if true;
      allow write: if false; // 정의되지 않은 임의의 컬렉션에 대한 무단 쓰기 차단
    }
  }
}
